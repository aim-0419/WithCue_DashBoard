{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "dev:backend": "python ./backend/app_web.py",
    "files:auto-sort": "powershell -ExecutionPolicy Bypass -File ./scripts/start-auto-sort.ps1",
    "files:auto-sort:mac": "bash ./scripts/start-auto-sort-macos.sh",
    "build:auto-sort-exe": "powershell -ExecutionPolicy Bypass -File ./scripts/build-auto-sort-exe.ps1",
    "build:auto-sort-macos": "bash ./scripts/build-auto-sort-macos.sh",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite",
    "dev:api": "node ./scripts/dev-api-server.mjs",
    "emulators": "npx firebase-tools@14 emulators:start --only auth,firestore --project withcuedashboard",
    "test:rules": "npx firebase-tools@14 emulators:exec --only firestore --project demo-withcue-rules --config firebase.rules-test.json \"node --test tests/firestore.rules.test.mjs\"",
    "test:api": "npx firebase-tools@14 emulators:exec --only auth,firestore --project withcuedashboard \"node tests/run-api-e2e.mjs\"",
    "test": "npm run test:rules && npm run test:api"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "firebase-admin": "^13.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.7",
    "@firebase/rules-unit-testing": "^5.0.2"
  }
}
