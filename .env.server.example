# 서버(api/**, Vercel Serverless Functions)용 환경변수 예시. 실제 값은 Vercel 프로젝트 설정에만 넣고 저장소에 커밋하지 않는다.

# 서비스 계정 키 JSON 전체를 한 줄 문자열로 넣는다(Google Cloud 콘솔 → IAM → 서비스 계정 → 키). 로컬 에뮬레이터 개발에서는 비워 둔다.
FIREBASE_SERVICE_ACCOUNT_JSON=

# 관리자 Google 계정 이메일 허용 목록. 쉼표로 구분하며 대소문자는 구분하지 않는다. 예: owner@example.com,manager@example.com
ADMIN_EMAILS=

# Firebase 프로젝트 ID. 비우면 서비스 계정의 project_id, 그것도 없으면 withcuedashboard를 쓴다.
FIREBASE_PROJECT_ID=withcuedashboard
