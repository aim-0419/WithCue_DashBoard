rules_version = '2';

// 브라우저(클라이언트 SDK)는 Firestore를 전혀 직접 다루지 않는다.
// 모든 접근은 서버 API(api/**)의 Admin SDK로만 한다. Admin SDK는 이 규칙을 거치지 않는다.
// 관리자 권한은 서버가 매 요청마다 ID 토큰 + 허용 목록(ADMIN_EMAILS)으로 확인하므로,
// 목록에서 빠진 관리자에게 role claim이 남아 있어도 Firestore에 직접 접근할 길이 없다.
service cloud.firestore {
  match /databases/{database}/documents {
    // 개인정보가 들어 있는 컬렉션.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /locationParticipants/{documentId} {
      allow read, write: if false;
    }

    match /collectionSessions/{documentId} {
      allow read, write: if false;
    }

    // 서버 전용 보조 데이터.
    match /systemCounters/{documentId} {
      allow read, write: if false;
    }

    match /locations/{documentId} {
      allow read, write: if false;
    }

    match /rateLimits/{documentId} {
      allow read, write: if false;
    }

    // 기존 데이터 보정 기록: 조회는 /api/admin/dashboard-data, 추가·삭제는 /api/admin/adjustments 로만.
    match /legacyAdjustments/{documentId} {
      allow read, write: if false;
    }

    // 그 밖의 모든 경로.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
